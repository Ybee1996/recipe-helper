# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# Neon Postgres (https://console.neon.tech) — required for recipes and notes
DATABASE_URL=

# Vercel Blob (https://vercel.com/docs/storage/vercel-blob) — recipe photos
BLOB_READ_WRITE_TOKEN=

# Household gate — required on the live site. Session cookie lasts 24 hours.
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
SITE_PASSWORD=
# Optional second password so you can rotate one without changing the other
SITE_PASSWORD_2=
